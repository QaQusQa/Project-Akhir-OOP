QWidget {
    background-color: #171a21;
    color: #c7d5e0;
    font-family: "Segoe UI", "Ubuntu", sans-serif;
    font-size: 13px;
}

QLabel#title {
    color: #66c0f4;
    font-weight: bold;
    padding: 10px 0;
}

QLabel {
    color: #8f98a0;
}

QPushButton {
    background-color: #212e3e;
    color: #c7d5e0;
    border: 1px solid #314152;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2c3f56;
    color: #ffffff;
    border-color: #66c0f4;
}

QPushButton:pressed {
    background-color: #16202d;
}

QPushButton:disabled {
    background-color: #151b22;
    color: #4f5a65;
    border-color: #212830;
}

QPushButton#add {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a9fff, stop:1 #0b78d1);
    color: #ffffff;
    border: none;
    font-weight: bold;
}

QPushButton#add:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #38a9ff, stop:1 #1a88e1);
}

QPushButton#add:pressed {
    background-color: #0b78d1;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #121923;
    color: #ffffff;
    border: 1px solid #2a3f5a;
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: #66c0f4;
    selection-color: #171a21;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #66c0f4;
    background-color: #16202d;
}

/* Dropdown ComboBox */
QComboBox::drop-down {
    border: none;
    width: 20px;
}

QListWidget {
    background-color: #10161f;
    border: 1px solid #243447;
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 10px 12px;
    border-radius: 4px;
    margin: 2px 4px;
    color: #c7d5e0;
}

QListWidget::item:hover {
    background-color: #1c2735;
    color: #ffffff;
}

QListWidget::item:selected {
    background-color: #2d4159;
    color: #ffffff;
    border-left: 3px solid #66c0f4;
}

/* Identitas Uap dan navigasi utama */
QLabel#title {
    color: #ffffff;
    font-size: 28px;
    letter-spacing: 3px;
}
QPushButton#navigation {
    background: transparent;
    border: none;
    border-radius: 0;
    color: #b8bfc7;
    font-size: 16px;
    font-weight: bold;
    padding: 12px 4px;
}
QPushButton#navigation:hover { color: #ffffff; }
QPushButton#navigation:checked {
    color: #66c0f4;
    border-bottom: 3px solid #1a9fff;
}
QWidget#hero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #263f55, stop:0.6 #1b2b3c, stop:1 #16202d);
    border: 1px solid #30475b;
    border-radius: 8px;
}
QWidget#hero QLabel { background: transparent; }
QLabel#heroTitle {
    color: #ffffff;
    font-size: 48px;
    font-weight: bold;
}
QLabel#heroDescription {
    color: #b8cad8;
    font-size: 16px;
}
QLabel#eyebrow {
    color: #66c0f4;
    font-size: 11px;
    font-weight: bold;
}
QLabel#stats {
    color: #8fa9bd;
    padding: 12px 0;
    font-size: 12px;
}
QLabel#sectionTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    padding: 8px 0;
}
QPushButton#danger:hover {
    color: #ffb4b4;
    border-color: #bc6262;
    background: #402b33;
}
QListWidget::item {
    padding: 16px;
    font-size: 15px;
}
QScrollBar:vertical {
    background: #10161f;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #40566b;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
