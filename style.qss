QWidget {
    background-color: #171a21;
    color: #c7d5e0;
    font-family: "Segoe UI", "Ubuntu", sans-serif;
    font-size: 13px;
}

QLabel#title {
    color: #66c0f4;
    font-weight: bold;
    padding: 10px 0;
}

QLabel {
    color: #8f98a0;
}

QPushButton {
    background-color: #212e3e;
    color: #c7d5e0;
    border: 1px solid #314152;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2c3f56;
    color: #ffffff;
    border-color: #66c0f4;
}

QPushButton:pressed {
    background-color: #16202d;
}

QPushButton:disabled {
    background-color: #151b22;
    color: #4f5a65;
    border-color: #212830;
}

QPushButton#add {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a9fff, stop:1 #0b78d1);
    color: #ffffff;
    border: none;
    font-weight: bold;
}

QPushButton#add:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #38a9ff, stop:1 #1a88e1);
}

QPushButton#add:pressed {
    background-color: #0b78d1;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #121923;
    color: #ffffff;
    border: 1px solid #2a3f5a;
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: #66c0f4;
    selection-color: #171a21;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #66c0f4;
    background-color: #16202d;
}

/* Dropdown ComboBox */
QComboBox::drop-down {
    border: none;
    width: 20px;
}

QListWidget {
    background-color: #10161f;
    border: 1px solid #243447;
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 10px 12px;
    border-radius: 4px;
    margin: 2px 4px;
    color: #c7d5e0;
}

QListWidget::item:hover {
    background-color: #1c2735;
    color: #ffffff;
}

QListWidget::item:selected {
    background-color: #2d4159;
    color: #ffffff;
    border-left: 3px solid #66c0f4;
}
